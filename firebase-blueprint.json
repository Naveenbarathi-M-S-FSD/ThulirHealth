{
  "entities": {
    "User": {
      "title": "User",
      "description": "Base user account profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User UID" },
        "username": { "type": "string", "description": "Username handle" },
        "email": { "type": "string", "description": "Email address" },
        "role": { "type": "string", "enum": ["patient", "doctor", "pharmacy"] },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    },
    "Patient": {
      "title": "Patient",
      "description": "Patient health profile and demographics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "patientId": { "type": "string" },
        "fullName": { "type": "string" },
        "gender": { "type": "string" },
        "dob": { "type": "string" },
        "age": { "type": "number" },
        "bloodGroup": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "location": { "type": "string" },
        "allergies": { "type": "array" },
        "existingConditions": { "type": "array" },
        "overallHealthStatus": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["patientId", "fullName", "phone"]
    },
    "Doctor": {
      "title": "Doctor",
      "description": "Doctor credentials and professional profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "doctorId": { "type": "string" },
        "fullName": { "type": "string" },
        "gender": { "type": "string" },
        "age": { "type": "number" },
        "specialization": { "type": "string" },
        "qualification": { "type": "string" },
        "registrationNumber": { "type": "string" },
        "yearsOfExperience": { "type": "number" },
        "hospitalName": { "type": "string" },
        "hospitalType": { "type": "string" },
        "location": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["doctorId", "fullName", "specialization"]
    },
    "Pharmacy": {
      "title": "Pharmacy",
      "description": "Pharmacy store profile and license information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "pharmacyId": { "type": "string" },
        "pharmacyName": { "type": "string" },
        "ownerName": { "type": "string" },
        "location": { "type": "string" },
        "address": { "type": "string" },
        "pharmacyType": { "type": "string" },
        "registrationNumber": { "type": "string" },
        "gstNumber": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["pharmacyId", "pharmacyName", "phone"]
    },
    "Prescription": {
      "title": "Prescription",
      "description": "Prescription record with medicine items and clinical dosage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "hospitalClinic": { "type": "string" },
        "date": { "type": "string" },
        "diagnosis": { "type": "string" },
        "medicines": { "type": "array" },
        "status": { "type": "string", "enum": ["Active", "Completed", "Previous"] },
        "source": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["patientId", "patientName", "medicines", "status"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Doctor-patient consultation booking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "specialization": { "type": "string" },
        "hospital": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "purpose": { "type": "string" },
        "status": { "type": "string", "enum": ["Upcoming", "Completed", "Cancelled", "In Consultation"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["patientId", "doctorId", "date", "time", "status"]
    },
    "HealthRecord": {
      "title": "HealthRecord",
      "description": "Uploaded or verified medical record document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "title": { "type": "string" },
        "recordType": { "type": "string" },
        "date": { "type": "string" },
        "doctor": { "type": "string" },
        "hospital": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["patientId", "title", "recordType", "date"]
    },
    "MedicineReminder": {
      "title": "MedicineReminder",
      "description": "Daily medication reminder alert",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "medicineName": { "type": "string" },
        "dosage": { "type": "string" },
        "time": { "type": "string" },
        "frequency": { "type": "string" },
        "duration": { "type": "string" },
        "takenToday": { "type": "boolean" },
        "takenAt": { "type": "string" },
        "nextScheduled": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["patientId", "medicineName", "time"]
    },
    "PharmacyProduct": {
      "title": "PharmacyProduct",
      "description": "Medicine or healthcare product listed by pharmacy",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pharmacyId": { "type": "string" },
        "pharmacyName": { "type": "string" },
        "productName": { "type": "string" },
        "companyName": { "type": "string" },
        "category": { "type": "string" },
        "mfgDate": { "type": "string" },
        "expiryDate": { "type": "string" },
        "contactNumber": { "type": "string" },
        "email": { "type": "string" },
        "originalPrice": { "type": "number" },
        "offerPrice": { "type": "number" },
        "discountPercentage": { "type": "number" },
        "availableQuantity": { "type": "number" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "stockStatus": { "type": "string" },
        "isOffer": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["pharmacyId", "productName", "offerPrice", "stockStatus"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "User notification alert",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "isRead": { "type": "boolean" },
        "link": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "message"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User authentication and profile document"
    },
    "/patients/{patientDocId}": {
      "schema": { "$ref": "#/entities/Patient" },
      "description": "Patient clinical profiles and demographics"
    },
    "/doctors/{doctorDocId}": {
      "schema": { "$ref": "#/entities/Doctor" },
      "description": "Doctor directory and clinical profile"
    },
    "/pharmacies/{pharmacyDocId}": {
      "schema": { "$ref": "#/entities/Pharmacy" },
      "description": "Pharmacy verified store profiles"
    },
    "/prescriptions/{prescriptionDocId}": {
      "schema": { "$ref": "#/entities/Prescription" },
      "description": "Prescriptions associated with patients and doctors"
    },
    "/appointments/{appointmentDocId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Scheduled appointments across the healthcare ecosystem"
    },
    "/healthRecords/{recordDocId}": {
      "schema": { "$ref": "#/entities/HealthRecord" },
      "description": "Medical documents and lab test records"
    },
    "/medicineReminders/{reminderDocId}": {
      "schema": { "$ref": "#/entities/MedicineReminder" },
      "description": "Patient medicine dosage reminders"
    },
    "/pharmacyProducts/{productDocId}": {
      "schema": { "$ref": "#/entities/PharmacyProduct" },
      "description": "Available pharmacy marketplace inventory"
    },
    "/notifications/{notificationDocId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "User alerts and appointment notifications"
    }
  }
}
